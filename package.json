{
  "name": "orvex",
  "private": true,
  "version": "1.0.0",
  "description": "ORVEX — a self-driving AI command center for the desktop",
  "author": "ORVEX",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "desktop:dev": "node scripts/electron-dev.mjs",
    "desktop": "npm run build && electron .",
    "icon": "electron scripts/make-icon.cjs",
    "smoke:gateway": "node scripts/run-smoke.mjs",
    "smoke:ui": "node scripts/smoke-ui.cjs",
    "smoke:ipc": "node scripts/smoke-llm-ipc.cjs",
    "smoke:agent": "node scripts/smoke-agent.cjs",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:security": "vitest run tests/security",
    "test:smoke": "npm run smoke:advanced && npm run smoke:memory && npm run smoke:productivity",
    "test:e2e": "node tests/e2e/app.e2e.mjs",
    "test:e2e:source": "node tests/e2e/app.e2e.mjs --target=source",
    "test:bench": "node scripts/run-electron-smoke.mjs scripts/bench-core.cjs",
    "test:eval": "node scripts/run-electron-smoke.mjs scripts/eval-agent.cjs",
    "test:visual": "node scripts/visual-compare.mjs",
    "test:visual:source": "node scripts/visual-compare.mjs --target=source",
    "test:visual:update": "node scripts/visual-compare.mjs --update",
    "test:all": "npm run test && npm run test:smoke && npm run test:e2e && npm run test:visual && npm run test:bench && npm run test:eval",
    "dist": "npm run build && electron-builder --win && node scripts/checksums.mjs",
    "dist:dir": "npm run build && electron-builder --win --dir",
    "smoke:orchestrator": "node scripts/smoke-orchestrator.cjs",
    "smoke:desktop": "node scripts/smoke-desktop.cjs",
    "smoke:airtouch": "node scripts/smoke-airtouch.cjs",
    "smoke:airtouch-ui": "node scripts/smoke-airtouch-ui.cjs",
    "smoke:voice": "node scripts/smoke-voice.cjs",
    "smoke:voice-ui": "node scripts/smoke-voice-ui.cjs",
    "smoke:code": "node scripts/smoke-code.cjs",
    "smoke:code-ui": "node scripts/smoke-code-ui.cjs",
    "smoke:research": "node scripts/smoke-research.cjs",
    "smoke:research-ui": "node scripts/smoke-research-ui.cjs",
    "smoke:memory": "node scripts/run-electron-smoke.mjs scripts/smoke-memory.cjs",
    "smoke:memory-ui": "node scripts/smoke-memory-ui.cjs",
    "smoke:files": "node scripts/smoke-files.cjs",
    "smoke:files-ui": "node scripts/smoke-files-ui.cjs",
    "smoke:media": "node scripts/smoke-media.cjs",
    "smoke:media-ui": "node scripts/smoke-media-ui.cjs",
    "smoke:control": "node scripts/smoke-control.cjs",
    "smoke:control-ui": "node scripts/smoke-control-ui.cjs",
    "smoke:integrations": "node scripts/smoke-integrations.cjs",
    "smoke:integrations-ui": "node scripts/smoke-integrations-ui.cjs",
    "smoke:workflows": "node scripts/smoke-workflows.cjs",
    "smoke:workflows-ui": "node scripts/smoke-workflows-ui.cjs",
    "smoke:dashboard-ui": "node scripts/smoke-dashboard-ui.cjs",
    "smoke:security": "node scripts/smoke-security.cjs",
    "smoke:security-ui": "node scripts/smoke-security-ui.cjs",
    "smoke:monitor": "node scripts/run-electron-smoke.mjs scripts/smoke-monitor.cjs",
    "smoke:monitor-ui": "node scripts/smoke-monitor-ui.cjs",
    "smoke:window-ui": "node scripts/smoke-window-ui.cjs",
    "smoke:productivity": "node scripts/run-electron-smoke.mjs scripts/smoke-productivity.cjs",
    "smoke:productivity-ui": "node scripts/smoke-productivity-ui.cjs",
    "smoke:training": "node scripts/run-electron-smoke.mjs scripts/smoke-training.cjs",
    "smoke:brain": "node scripts/run-electron-smoke.mjs scripts/smoke-brain.cjs",
    "smoke:learner": "node scripts/run-electron-smoke.mjs scripts/smoke-learner.cjs",
    "smoke:workforce": "node scripts/run-electron-smoke.mjs scripts/smoke-workforce.cjs",
    "smoke:connectors": "node scripts/run-electron-smoke.mjs scripts/smoke-connectors.cjs",
    "smoke:hands": "node scripts/run-electron-smoke.mjs scripts/smoke-hands.cjs",
    "smoke:maker": "node scripts/run-electron-smoke.mjs scripts/smoke-maker.cjs",
    "smoke:advisor": "node scripts/run-electron-smoke.mjs scripts/smoke-advisor.cjs",
    "smoke:agent-guard": "node scripts/run-electron-smoke.mjs scripts/smoke-agent-guard.cjs",
    "smoke:advanced": "node scripts/run-electron-smoke.mjs scripts/smoke-advanced.cjs",
    "smoke:advanced-ui": "node scripts/smoke-advanced-ui.cjs",
    "smoke:planning": "node scripts/run-electron-smoke.mjs scripts/smoke-planning.cjs",
    "checksums": "node scripts/checksums.mjs",
    "catalog:keygen": "node scripts/catalog-keygen.mjs",
    "catalog:build": "node scripts/build-catalog.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.2.0",
    "ajv": "^8.20.0",
    "archiver": "^7.0.1",
    "better-sqlite3": "^11.10.0",
    "chokidar": "^4.0.3",
    "diff": "^9.0.0",
    "docx": "^9.15.0",
    "framer-motion": "^11.11.17",
    "imapflow": "^2.10.0",
    "js-yaml": "^4.3.2",
    "lucide-react": "^0.469.0",
    "mailparser": "^3.14.1",
    "mammoth": "^1.9.1",
    "music-metadata": "^7.14.0",
    "nodemailer": "^10.3.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "pg": "^8.23.1",
    "playwright-core": "^1.64.1",
    "pptxgenjs": "^4.0.1",
    "prebuild-install": "^7.1.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.3",
    "reactflow": "^11.11.4",
    "remark-gfm": "^4.0.0",
    "sharp": "^0.33.5",
    "unzipper": "^0.12.5",
    "ws": "^8.22.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "electron": "^33.4.11",
    "electron-builder": "^26.18.0",
    "playwright": "^1.64.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^3.2.7"
  },
  "build": {
    "appId": "com.orvex.app",
    "productName": "ORVEX",
    "copyright": "Copyright © 2026 ORVEX",
    "asar": true,
    "asarUnpack": [
      "**/*.node"
    ],
    "npmRebuild": false,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ORVEX",
      "uninstallDisplayName": "ORVEX ${version}",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}.${ext}"
    }
  }
}
